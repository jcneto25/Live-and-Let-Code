/.superpowers
/docs/superpowers
/CLAUDE.md

# Local AI tooling dirs (per-clone, not shared)
/.claude/
/.commandcode/
/.omc/
/.workbuddy-ai/

# Python bytecode caches
__pycache__/
*.py[cod]

# Security scan artifacts — raw tool outputs are machine-generated and ephemeral.
# They change with every rerun. Consolidated reports in docs/security/ are the
# version-controlled source of truth.
.ace/security/*
!.ace/security/.gitkeep

# Test coverage analysis — ephemeral machine-generated output (regularamente validado por fitness module_coverage)
coverage/

# pytest-cov local artifacts
.coverage
coverage.lcov
coverage.lcov.*

# ACE worktrees — `initialize_session.py` cria um worktree por sessão
# (`.ace/worktrees/<session_id>/`, branch `session/<id>`). É uma árvore de
# trabalho completa e descartável: commitar significaria duplicar o repo.
.ace/worktrees/

# Backup do índice ACE, criado por `rebuild-index.py` antes de sobrescrever
.ace/index.json.bak
